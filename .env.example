# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore.
# Dozwolony jest WYŁĄCZNIE endpoint paper. Każdy inny URL zatrzymuje program.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Konto paper #1 — agent LLM
ALPACA_LLM_API_KEY=
ALPACA_LLM_SECRET_KEY=

# Konto paper #2 — agent bazowy SMA 20/50
ALPACA_SMA_API_KEY=
ALPACA_SMA_SECRET_KEY=

# Claude: NIE potrzeba klucza API. Agent LLM używa Claude Code CLI zalogowanego kontem
# z subskrypcją (`claude auth login` na tej maszynie). Opcjonalnie zamiast logowania:
# token z `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=
